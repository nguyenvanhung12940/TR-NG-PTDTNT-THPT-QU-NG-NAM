rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'hainguyenbtm.070589@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'role', 'teacherApproved', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'role', 'teacherApproved', 'className', 'homeroom', 'subjectTeacher', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.role in ['student', 'teacher']
        && data.teacherApproved is bool
        && (!('className' in data) || (data.className is string && data.className.size() <= 40))
        && (!('homeroom' in data) || (data.homeroom is string && data.homeroom.size() <= 40))
        && (!('subjectTeacher' in data) || (data.subjectTeacher is string && data.subjectTeacher.size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'birthDate', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() <= 20))
        && data.updatedAt is timestamp;
    }

    function isValidStudyTask(data) {
      return data.keys().hasAll(['userId', 'name', 'subject', 'goal', 'dueDate', 'studySlot', 'done', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'name', 'subject', 'goal', 'dueDate', 'studySlot', 'done', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 100
        && data.goal is string && data.goal.size() >= 1 && data.goal.size() <= 300
        && data.dueDate is string && data.dueDate.size() >= 8 && data.dueDate.size() <= 20
        && data.studySlot is string && data.studySlot.size() >= 1 && data.studySlot.size() <= 100
        && data.done is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidThinkEntry(data) {
      return data.keys().hasAll(['userId', 'subject', 'question', 'answer', 'confidence', 'createdAt'])
        && data.keys().hasOnly(['userId', 'subject', 'question', 'answer', 'confidence', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 100
        && data.question is string && data.question.size() >= 1 && data.question.size() <= 500
        && data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 3000
        && data.confidence is string && data.confidence.size() >= 1 && data.confidence.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidFactCheck(data) {
      return data.keys().hasAll(['userId', 'content', 'source', 'conclusion', 'createdAt'])
        && data.keys().hasOnly(['userId', 'content', 'source', 'conclusion', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 3000
        && data.source is string && data.source.size() >= 1 && data.source.size() <= 1000
        && data.conclusion is string && data.conclusion.size() >= 1 && data.conclusion.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidSelfTest(data) {
      return data.keys().hasAll(['userId', 'subject', 'lesson', 'explain', 'apply', 'level', 'createdAt'])
        && data.keys().hasOnly(['userId', 'subject', 'lesson', 'explain', 'apply', 'level', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 100
        && data.lesson is string && data.lesson.size() >= 1 && data.lesson.size() <= 200
        && data.explain is string && data.explain.size() >= 1 && data.explain.size() <= 3000
        && data.apply is string && data.apply.size() >= 1 && data.apply.size() <= 3000
        && data.level is string && data.level.size() >= 1 && data.level.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidSurvey(data) {
      return data.keys().hasAll(['userId', 'surveyType', 'answers', 'average', 'createdAt'])
        && data.keys().hasOnly(['userId', 'surveyType', 'answers', 'average', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && data.surveyType in ['before', 'after']
        && data.answers is list && data.answers.size() == 7 && data.answers[0] is number
        && data.average is number && data.average >= 1 && data.average <= 5
        && data.createdAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isBootstrapAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().teacherApproved == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isSignedIn()
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().teacherApproved == existing().teacherApproved
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'role', 'className', 'homeroom', 'subjectTeacher', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'info' && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isValidId(userId) && isValidId(docId) && docId == 'info'
          && isOwner(userId)
          && isValidPrivateInfo(incoming())
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) && docId == 'info'
          && isOwner(userId)
          && isValidPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'birthDate', 'updatedAt']);
        allow delete: if isValidId(userId) && isAdmin();
      }

      match /studyTasks/{taskId} {
        allow get: if isValidId(userId) && isValidId(taskId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());
        allow create: if isValidId(userId) && isValidId(taskId)
          && isOwner(userId)
          && isValidStudyTask(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(taskId)
          && isValidStudyTask(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['done', 'name', 'goal', 'dueDate', 'studySlot', 'subject', 'updatedAt']))
          );
        allow delete: if isValidId(userId) && isValidId(taskId) && (isOwner(userId) || isAdmin());
      }

      match /thinkEntries/{entryId} {
        allow get: if isValidId(userId) && isValidId(entryId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());
        allow create: if isValidId(userId) && isValidId(entryId)
          && isOwner(userId)
          && isValidThinkEntry(incoming())
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(entryId) && (isOwner(userId) || isAdmin());
      }

      match /factChecks/{factId} {
        allow get: if isValidId(userId) && isValidId(factId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());
        allow create: if isValidId(userId) && isValidId(factId)
          && isOwner(userId)
          && isValidFactCheck(incoming())
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(factId) && (isOwner(userId) || isAdmin());
      }

      match /selfTests/{testId} {
        allow get: if isValidId(userId) && isValidId(testId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());
        allow create: if isValidId(userId) && isValidId(testId)
          && isOwner(userId)
          && isValidSelfTest(incoming())
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(testId) && (isOwner(userId) || isAdmin());
      }

      match /surveys/{surveyId} {
        allow get: if isValidId(userId) && isValidId(surveyId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());
        allow create: if isValidId(userId) && isValidId(surveyId)
          && isOwner(userId)
          && isValidSurvey(incoming())
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(surveyId) && (isOwner(userId) || isAdmin());
      }
    }
  }
}
